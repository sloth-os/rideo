# --- Rideo server ---------------------------------------------------------
RIDEO_PORT=8787
RIDEO_PUBLIC_URL=http://localhost:8787
# Bearer token protecting /api, /api/live and /mcp (leave empty for local use)
RIDEO_API_TOKEN=
RIDEO_DATA_DIR=./data

# --- WebDAV (leave RIDEO_WEBDAV_URL empty to use the embedded /dav server) ---
RIDEO_WEBDAV_URL=
RIDEO_WEBDAV_USERNAME=
RIDEO_WEBDAV_PASSWORD=
RIDEO_WEBDAV_ROOT=/rideo

# --- mm-gateway ---------------------------------------------------------------
MM_GATEWAY_URL=http://localhost:8000
MM_GATEWAY_API_KEY=
RIDEO_IMAGE_MODEL=auto
RIDEO_VIDEO_MODEL=auto
RIDEO_MUSIC_MODEL=auto

# LLM / vision / STT go through the gateway proxy: /proxy/{domain}/{path}
RIDEO_LLM_PROVIDER=openai
RIDEO_LLM_PROXY_DOMAIN=api.openai.com
RIDEO_LLM_MODEL=gpt-4.1-mini
RIDEO_VISION_MODEL=
RIDEO_STT_PROXY_DOMAIN=
RIDEO_STT_MODEL=whisper-1

# --- Consistency & watermark --------------------------------------------------
RIDEO_CONSISTENCY_JUDGE=vision-llm
RIDEO_CONSISTENCY_THRESHOLD=0.75
RIDEO_WATERMARK_KEY=change-me-to-a-long-random-secret
RIDEO_BRAND_NAME=Rideo
RIDEO_BRAND_OWNER=
RIDEO_BRAND_URL=
