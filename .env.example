# Rideo starts without any configuration: open the studio and set it up in Settings (docs/design/settings.md):
# storage (WebDAV, the built-in server or each person's browser), mm-gateway, models, voices, accounts, brand,
# provenance, limits and the theme. A variable set here wins over Settings and shows locked there, so keep this file
# for what must be fixed before the studio starts (docs/deployment.md#environment).

# --- Process (environment only) ----------------------------------------------------------------
RIDEO_PORT=8787
RIDEO_DATA_DIR=./data
# External URL, with the subpath when Rideo is served under one behind a proxy (docs/design/subpath.md)
# RIDEO_PUBLIC_URL=https://example.com/rideo
# RIDEO_BASE_PATH=/rideo
# Bearer token protecting /api, /api/live and /mcp (leave empty for local use)
RIDEO_API_TOKEN=
# Secret key of the invisible watermark: set it in production (otherwise one is generated into the data dir)
# RIDEO_WATERMARK_KEY=change-me-to-a-long-random-secret

# --- Settings pinned by the deployment (optional; otherwise set them in the studio) -----------
# RIDEO_STORAGE=webdav
# RIDEO_WEBDAV_URL=https://files.example.com/dav
# RIDEO_WEBDAV_USERNAME=
# RIDEO_WEBDAV_PASSWORD=
# MM_GATEWAY_URL=http://localhost:8000
# MM_GATEWAY_API_KEY=
# The gateway's MANAGEMENT_API_KEY: lets the studio register the API keys below as gateway proxies
# MM_GATEWAY_ADMIN_KEY=
# RIDEO_LLM_PROVIDER=openai
# The API base URL as the provider documents it (or just its domain), and its key
# RIDEO_LLM_PROXY_DOMAIN=https://api.openai.com/v1
# RIDEO_LLM_API_KEY=
# RIDEO_LLM_MODEL=gpt-4.1-mini
